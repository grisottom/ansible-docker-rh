<?xml version="1.0"?>
<module xmlns="urn:jboss:module:1.3" name="com.oracle.weblogic.client">
  <resources>
    <resource-root path="wlthint3client-14.1.1.jar">
      <filter>
        <exclude path="javax"/>
        <exclude path="javax/"/>
      </filter>
    </resource-root>
  </resources>
  <dependencies>
    <module name="sun.jdk" export="false" services="import">
      <exports>
        <include-set>
          <path name="sun/security/acl"/>
          <path name="META-INF/services"/>
        </include-set>
      </exports>
    </module>
    <module name="com.sun.xml.bind"/>
    <module name="org.omg.api"/>
    <module name="org.picketbox" optional="true"/>
    <module name="org.jboss.logging" optional="true"/>
    <module name="org.jboss.as.web" optional="true"/>
    <module name="org.jboss.as.ejb3" optional="true"/>
    <module name="javaee.api"/>
    <module name="javax.api"/>
  </dependencies>
</module>
